# Postgres common data for Koios,Dandelion-PostGREST and cardano-sql
#WARNING: cardano-graphql-hasura needs it as 'postgres'
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=dandelion1234
POSTGRES_USER=dandelion_user
POSTGRES_DB=dandelion_lite  
POSTGRES_PORT=${PORT_OFFSET}5432

POSTGRES_MAX_CONNECTIONS=200
POSTGRES_WAL_LEVEL=minimal
POSTGRES_MAX_WAL_SENDERS=0
POSTGRES_SYNCHRONOUS_COMMIT=off

# For running "Initialize Postgres" for the first time (large indexing)
# POSTGRES_MAINTENANCE_WORK_MEM=8192MB
# POSTGRES_MAX_PARALLEL_MAINTENANCE_WORKERS=16
# POSTGRES_MAX_PARALLEL_WORKERS=64
# POSTGRES_MAX_WORKER_PROCESSES=128
# POSTGRES_MAINTENANCE_IO_CONCURRENCY=200
# POSTGRES_SHARED_BUFFERS=32GB
# POSTGRES_SHM_SIZE=32gb

# For standard operations
POSTGRES_MAINTENANCE_WORK_MEM=1024MB
POSTGRES_MAX_PARALLEL_MAINTENANCE_WORKERS=8
POSTGRES_MAX_PARALLEL_WORKERS=32
POSTGRES_MAX_WORKER_PROCESSES=16
POSTGRES_MAINTENANCE_IO_CONCURRENCY=32
POSTGRES_SHARED_BUFFERS=8GB
POSTGRES_SHM_SIZE=8gb

# Koios Artifacts/Koios Lite PostGREST
POSTGREST_HOST=postgrest
POSTGREST_DB_ANON_ROLE=web_anon
#comma separated, first one is default schema, others are accessed by explicitly using the schema name in queries
POSTGREST_DB_SCHEMAS="${KOIOS_ARTIFACTS_SCHEMA},${KOIOS_LITE_SCHEMA}"
POSTGREST_DB_EXTRA_SEARCH_PATH="${POSTGREST_DB_SCHEMAS},public"
POSTGREST_PORT=${PORT_OFFSET}8050
KOIOS_VERSION=1.3.2
KOIOS_IMAGE=""
NODE_EXTENSIONS="${NODE_EXTENSIONS},{\"name\":\"${KOIOS_ARTIFACTS_SCHEMA}\",\"path\":\"koios/\",\"version\":\"${KOIOS_VERSION}\",\"image\":\"${KOIOS_IMAGE}\"}"
INDEX_LINKS="${INDEX_LINKS}<li><a href=\"koios/\">Koios (koios-artifacts)</a></li>"



# Cardano GraphQL MKII
CARDANO_GRAPHQL_VERSION=0.4.0
CARDANO_GRAPHQL_IMAGE=ghcr.io/gamechangerfinance/cardano-graphql:${CARDANO_GRAPHQL_VERSION:-0.4.0}
CARDANO_GRAPHQL_HOST=cardano-graphql
CARDANO_GRAPHQL_PATH=cardano-graphql-mk2
CARDANO_GRAPHQL_PORT=${PORT_OFFSET}4000
CARDANO_GRAPHQL_CORS=true

CARDANO_GRAPHQL_GRAPHQL_PATH=/graphql
CARDANO_GRAPHQL_GRAPHQL_PLAYGROUND_API_PATH=/${CARDANO_GRAPHQL_PATH}${CARDANO_GRAPHQL_GRAPHQL_PATH}
CARDANO_GRAPHQL_GRAPHQL_PLAYGROUND_PATH=/graphql
CARDANO_GRAPHQL_GRAPHQL_PLAYGROUND_STATIC_PATH=
CARDANO_GRAPHQL_SERVER_URI=http://localhost:4000${CARDANO_GRAPHQL_GRAPHQL_PATH}

CARDANO_GRAPHQL_DLT=${DLT}
CARDANO_GRAPHQL_NETWORK=${NETWORK}
CARDANO_GRAPHQL_POSTGRES_URI=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:5432/${POSTGRES_DB}
CARDANO_GRAPHQL_POSTGRES_ROLE=web_anon
CARDANO_GRAPHQL_POSTGRES_MIGRATIONS_DIR=/migrations/apply
CARDANO_GRAPHQL_POSTGRES_MIGRATIONS_RESET_DIR=/migrations/reset
CARDANO_GRAPHQL_OGMIOS_URI=http://${OGMIOS_HOST}:1337
CARDANO_GRAPHQL_OGMIOS_MIN_SYNC=0.90
CARDANO_GRAPHQL_GRAPHQL_EXPLAIN=false

CARDANO_GRAPHQL_CACHE_ENABLE=true
CARDANO_GRAPHQL_CACHE_PUBLISH=true
CARDANO_GRAPHQL_WHITELIST_ENABLE=${CARDANO_GRAPHQL_WHITELIST_ENABLE:-}
CARDANO_GRAPHQL_WHITELIST_PUBLISH=true
CARDANO_GRAPHQL_WHITELIST_UPDATE_MINS=30
# add whitelists from allowed sources here separated with comma, example: "https://wallet.gamechanger.finance/config/gql-whitelist.json"
CARDANO_GRAPHQL_WHITELIST_SOURCES=${CARDANO_GRAPHQL_WHITELIST_SOURCES:-}

NODE_EXTENSIONS="${NODE_EXTENSIONS},{\"name\":\"cardano_graphql_mk2\",\"path\":\"${CARDANO_GRAPHQL_PATH}${CARDANO_GRAPHQL_GRAPHQL_PATH}/\",\"version\":\"${CARDANO_GRAPHQL_VERSION}\",\"image\":\"${CARDANO_GRAPHQL_IMAGE}\"}"
INDEX_LINKS="${INDEX_LINKS}<li><a href=\"${CARDANO_GRAPHQL_PATH}${CARDANO_GRAPHQL_GRAPHQL_PATH}\">Cardano GraphQL MKII</a></li>"



# Dandelion PostGREST
DANDELION_POSTGREST_HOST=dandelion-postgrest
DANDELION_POSTGREST_DB_ANON_ROLE=${POSTGREST_DB_ANON_ROLE}
#comma separated, first one is default schema, others are accessed by explicitly using the schema name in queries
DANDELION_POSTGREST_DB_SCHEMAS="${DANDELION_POSTGREST_SCHEMA}"
DANDELION_POSTGREST_DB_EXTRA_SEARCH_PATH=${DANDELION_POSTGREST_SCHEMA}
DANDELION_POSTGREST_PORT=${PORT_OFFSET}8060
DANDELION_POSTGREST_VERSION="f814f568b389f13e75230f1d3175210abfddb7e9"
NODE_EXTENSIONS="${NODE_EXTENSIONS},{\"name\":\"${DANDELION_POSTGREST_SCHEMA}\",\"path\":\"postgrest/\",\"version\":\"${DANDELION_POSTGREST_VERSION}\",\"image\":\"\"}"
INDEX_LINKS="${INDEX_LINKS}<li><a href=\"postgrest/\">Dandelion PostGREST</a></li>"

